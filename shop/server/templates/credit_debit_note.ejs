<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title><%= (note && note.noteType) ? note.noteType : '' %> Note</title>
    <style>
        body { font-family: 'Helvetica Neue', 'Helvetica', Helvetica, Arial, sans-serif; padding: 30px; font-size: 14px; color: #334155; }
        .invoice-box { max-width: 800px; margin: auto; padding: 30px; border: 1px solid #eee; box-shadow: 0 0 10px rgba(0, 0, 0, .08); border-radius: 12px; }
        .header { display: flex; justify-content: space-between; border-bottom: 2px solid #23b3f4; padding-bottom: 20px; margin-bottom: 20px; }
        .header h1 { margin: 0; color: #23b3f4; font-size: 24px; }
        .company-details, .customer-details { margin-bottom: 20px; }
        table { width: 100%; line-height: inherit; text-align: left; border-collapse: collapse; margin-top: 15px; }
        table th, table td { padding: 10px; border-bottom: 1px solid #e5e7eb; font-size: 13px; }
        table th { background: #f8fafc; font-weight: bold; color: #64748b; text-transform: uppercase; font-size: 11px; letter-spacing: 0.05em; }
        .totals { text-align: right; margin-top: 20px; }
        .totals p { margin: 5px 0; font-size: 13px; }
        .totals p.grand-total { font-size: 17px; font-weight: bold; color: #23b3f4; border-top: 2px solid #23b3f4; padding-top: 10px; margin-top: 10px; }
    </style>
</head>
<body>
    <div class="invoice-box">
        <div class="header">
            <div>
                <h1><%= (note && note.noteType) ? note.noteType : 'CREDIT/DEBIT' %> NOTE</h1>
                <p style="margin-top: 8px; font-weight: 600;">
                  Note #: <%= (note && note.noteNumber) ? note.noteNumber : 'N/A' %><br>
                  Date: <%= (note && note.date) ? new Date(note.date).toLocaleDateString('en-GB') : 'N/A' %><br>
                  Reason: <%= (note && note.reason) ? note.reason : 'N/A' %>
                </p>
            </div>
            <div style="text-align: right;">
                <h2 style="margin: 0; font-size: 18px;"><%= (shop && shop.name) ? shop.name : 'Company' %></h2>
                <p style="margin-top: 5px; font-size: 12px; color: #64748b;">
                  GSTIN: <%= (shop && (shop.gst_no || shop.gstin)) ? (shop.gst_no || shop.gstin) : 'N/A' %><br>
                  Address: <%= (shop && shop.address) ? shop.address : '' %>
                </p>
            </div>
        </div>

        <div class="customer-details">
            <strong style="color: #64748b; font-size: 12px; text-transform: uppercase;">Party Details:</strong><br>
            <span style="font-weight: 700; font-size: 15px;"><%= (note && note.partyDetails && note.partyDetails.name) ? note.partyDetails.name : 'Party' %></span><br>
            GSTIN: <%= (note && note.partyDetails && note.partyDetails.gstin) ? note.partyDetails.gstin : 'N/A' %><br>
            Address: <%= (note && note.partyDetails) ? (note.partyDetails.address || '') : '' %> <%= (note && note.partyDetails && note.partyDetails.state) ? (', ' + note.partyDetails.state) : '' %>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Item</th>
                    <th>HSN</th>
                    <th>Qty</th>
                    <th>Price</th>
                    <th>CGST</th>
                    <th>SGST</th>
                    <th>IGST</th>
                    <th style="text-align: right;">Total</th>
                </tr>
            </thead>
            <tbody>
                <% if (note && note.items && note.items.length > 0) { %>
                  <% note.items.forEach(function(item) { %>
                  <tr>
                      <td><%= item.name || '' %><br><small style="color: #94a3b8;"><%= (item.serialNumbers && item.serialNumbers.length) ? item.serialNumbers.join(', ') : '' %></small></td>
                      <td><%= item.hsnCode || '—' %></td>
                      <td><%= item.quantity || 1 %></td>
                      <td>₹<%= Number(item.unitPrice || item.rate || 0).toFixed(2) %></td>
                      <td>₹<%= Number(item.cgstAmount != null ? item.cgstAmount : item.cgst || 0).toFixed(2) %></td>
                      <td>₹<%= Number(item.sgstAmount != null ? item.sgstAmount : item.sgst || 0).toFixed(2) %></td>
                      <td>₹<%= Number(item.igstAmount != null ? item.igstAmount : item.igst || 0).toFixed(2) %></td>
                      <td style="text-align: right; font-weight: 700;">₹<%= Number(item.totalAmount != null ? item.totalAmount : item.finalAmount || 0).toFixed(2) %></td>
                  </tr>
                  <% }); %>
                <% } else { %>
                  <tr><td colspan="8" style="text-align: center; color: #94a3b8;">No items</td></tr>
                <% } %>
            </tbody>
        </table>

        <div class="totals">
            <p>Subtotal: ₹<%= Number((note && note.summary) ? (note.summary.subTotal || note.summary.taxableValue || 0) : 0).toFixed(2) %></p>
            <% if (note && note.summary && (note.summary.totalCGST > 0 || note.summary.cgstTotal > 0)) { %>
              <p>CGST: ₹<%= Number(note.summary.totalCGST || note.summary.cgstTotal || 0).toFixed(2) %></p>
            <% } %>
            <% if (note && note.summary && (note.summary.totalSGST > 0 || note.summary.sgstTotal > 0)) { %>
              <p>SGST: ₹<%= Number(note.summary.totalSGST || note.summary.sgstTotal || 0).toFixed(2) %></p>
            <% } %>
            <% if (note && note.summary && (note.summary.totalIGST > 0 || note.summary.igstTotal > 0)) { %>
              <p>IGST: ₹<%= Number(note.summary.totalIGST || note.summary.igstTotal || 0).toFixed(2) %></p>
            <% } %>
            <p class="grand-total">Total Adjusted: ₹<%= Number((note && note.summary) ? (note.summary.grandTotal || 0) : 0).toFixed(2) %></p>
        </div>
        
        <% if (note && note.notes) { %>
          <div style="margin-top: 40px; border-top: 1px solid #e5e7eb; padding-top: 15px;">
              <p style="font-size: 12px; color: #64748b;"><strong>Notes:</strong> <%= note.notes %></p>
          </div>
        <% } %>
    </div>
</body>
</html>
