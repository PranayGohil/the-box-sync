# Architect PMS Client Environment Variables Template

# Backend API Base URL
# Local Dev: /api (proxied by Vite) or http://localhost:5004/api
# VPS Prod: https://architect-pms-api.theboxsync.com/api
VITE_API_BASE_URL=/api

# Backend Base Server URL (for static uploads resolution)
# Local Dev: http://localhost:5004
# VPS Prod: https://architect-pms-api.theboxsync.com
VITE_SERVER_BASE_URL=http://localhost:5004

# Backend Target for Vite Development Proxy
VITE_API_TARGET=http://localhost:5004

# Application Metadata
VITE_APP_NAME="Architect PMS"
